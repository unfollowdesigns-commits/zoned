# Copy to .env and fill in from your Supabase project settings.
# The publishable (anon) key is safe to ship in the app: row level security in
# supabase/migrations/0001_init.sql is what actually protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
