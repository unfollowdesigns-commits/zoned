{
  "expo": {
    "name": "Zoned",
    "slug": "zoned",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "zoned",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zoned.app",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Zoned connects to your heart rate sensor over Bluetooth to record heart rate and beat-to-beat intervals.",
        "UIBackgroundModes": ["bluetooth-central"]
      }
    },
    "android": {
      "package": "com.zoned.app",
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": ["central"],
          "bluetoothAlwaysPermission": "Zoned connects to your heart rate sensor over Bluetooth."
        }
      ]
    ]
  }
}
