{
  "name": "zoned",
  "private": true,
  "version": "0.1.0",
  "description": "An open, self-built wearable recovery tracker: sensor -> phone -> dashboard.",
  "workspaces": [
    "packages/*",
    "apps/web"
  ],
  "scripts": {
    "test": "npm run test --workspace @zoned/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspace @zoned/web",
    "dev": "npm run dev --workspace @zoned/web"
  },
  "engines": {
    "node": ">=20"
  }
}
