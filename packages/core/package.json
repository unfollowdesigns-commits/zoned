{
  "name": "@zoned/core",
  "version": "0.1.0",
  "description": "Device-agnostic physiology engine: HRV, recovery, strain, sleep.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
