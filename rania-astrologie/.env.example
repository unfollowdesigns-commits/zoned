# ─────────────────────────────────────────────────────────────
#  Rania — Astrologie · variables d'environnement
#  Copiez ce fichier en `.env.local` (développement) et renseignez
#  les mêmes variables dans votre hébergeur (production).
# ─────────────────────────────────────────────────────────────

# URL publique du site (sans slash final) — utilisée pour le SEO, les e-mails, le sitemap
SITE_URL=http://localhost:3000

# Base de données (libSQL / SQLite)
#  - En local : un fichier SQLite
#  - En production : une base Turso (https://turso.tech), ex. libsql://rania-xxx.turso.io
DATABASE_URL=file:./db/rania.db
DATABASE_AUTH_TOKEN=

# Secret serveur (32+ caractères aléatoires) — sert à signer/hacher les jetons.
#  Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Compte administrateur initial (utilisé par `npm run db:seed` / `npm run admin:create`)
ADMIN_EMAIL=rania@example.com
ADMIN_PASSWORD=

# E-mails transactionnels (SMTP). Laisser vide en développement : les e-mails sont affichés dans la console.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Rania Astrologie <contact@example.com>"
# Adresse qui reçoit les notifications (nouvelles demandes, messages)
NOTIFY_EMAIL=rania@example.com
